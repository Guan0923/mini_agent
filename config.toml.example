# Copy this file to ~/.mini_agent/config.toml for standalone offline TUI use.
# The client reads only this TOML file; it does not apply process-environment overrides.
[model]
provider = "deepseek"
api_key = "replace-with-your-key"
# Accepted forms: service root, /v1 URL, or the complete /chat/completions endpoint.
base_url = "https://api.deepseek.com"
model = "deepseek-chat"
max_tokens = 8192
context_size = 1024000
tokenizer_model = "deepseek-ai/DeepSeek-V3"

[runtime]
# true stores complete recursively redacted bodies; false stores summaries.
log_full_messages = true

[web]
# Browser URL and CORS origins used by the FastAPI web client.
public_url = "http://localhost:5173"
allowed_origins = ["http://localhost:5173", "http://127.0.0.1:5173"]
# Set true when the web app is served over HTTPS.
cookie_secure = false
# Account registration, password reset, SMTP, PostgreSQL and the cloud master
# key belong to the independent cloud process. They are never read from this
# local client TOML file; see cloud/.env.example or compose.yml.

[sync]
# device_id is generated automatically and remains stable on this client.
# Synchronization is optional. Configure both values to enable lifecycle-triggered HTTPS sync.
# url = "https://sync.example.com"
# token = "replace-with-a-sync-bearer-token"

[mcp]
initialization_timeout_seconds = 15
call_timeout_seconds = 60
shutdown_timeout_seconds = 5

[skills]
# Explicit $skill-name references always activate directly. Enable this only
# when an extra model preflight for tasks without an explicit reference is desired.
auto_select = false

[subagents]
max_tasks_per_batch = 8
max_workers = 4
task_timeout_seconds = 300
batch_timeout_seconds = 600
