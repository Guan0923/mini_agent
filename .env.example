# OpenAI-compatible Chat Completions endpoint. Do not commit your real .env file.
API_KEY=replace-with-your-key
BASE_URL=https://api.example.com/v1
MODEL=replace-with-your-model-name
PROVIDER=deepseek
# Output-token cap for DeepSeek JSON responses. Valid range: 1-384000.
MAX_TOKENS=8192
# Total context window. DeepSeek defaults to 1,024,000 tokens.
CONTEXT_SIZE=1024000
# Hugging Face tokenizer used for local context estimates. Model weights are not downloaded.
TOKENIZER_MODEL=deepseek-ai/DeepSeek-V3
# Persist complete model/runtime message bodies in diagnostic traces. Set false to store summaries instead.
LOG_FULL_MESSAGES=True
