# DeepSeek/OpenAI-compatible Chat Completions configuration.
# Copy this file to .env and replace the placeholders. Never commit .env.
PROVIDER=deepseek
API_KEY=replace-with-your-key
# Accepted forms: service root, a URL ending in /v1, or the full /chat/completions endpoint.
BASE_URL=https://api.deepseek.com
MODEL=deepseek-chat

# Maximum output tokens per model request. Valid range: 1-384000.
MAX_TOKENS=8192
# Total context window; it must be greater than MAX_TOKENS.
CONTEXT_SIZE=1024000
# Hugging Face tokenizer used for local estimates; model weights are not downloaded.
TOKENIZER_MODEL=deepseek-ai/DeepSeek-V3

# true stores complete recursively redacted message/wire bodies; false stores summaries.
LOG_FULL_MESSAGES=true
